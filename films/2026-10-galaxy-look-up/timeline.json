 "lines": [
  {
   "id": "eyes",
   "start": 7.0,
   "dur": 6.133,
   "text": "For as long as we've had eyes, we've looked up, and drawn stories in the stars."
  },
  {
   "id": "further",
   "start": 16.5,
   "dur": 1.639,
   "text": "Now go further."
  },
  {
   "id": "past",
   "start": 22.5,
   "dur": 3.131,
   "text": "Past the Moon. Past a living Sun."
  },
  {
   "id": "stars",
   "start": 39.0,
   "dur": 5.152,
   "text": "Out into eighty-five thousand stars, every one of them made by code."
  },
  {
   "id": "jets",
   "start": 46.5,
   "dur": 6.43,
   "text": "Further still, to galaxies that fire jets of plasma across the dark."
  },
  {
   "id": "page",
   "start": 61.0,
   "dur": 2.642,
   "text": "And all of it lives in one web page."
  },
  {
   "id": "open",
   "start": 65.0,
   "dur": 4.326,
   "text": "No install. Just open it, and look up."
  }
 ],
