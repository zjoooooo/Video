 "lines": [
  {
   "id": "forest",
   "start": 2.0,
   "dur": 4.207,
   "text": "宇宙是一座黑暗森林。每个文明，都是带枪的猎人。"
  },
  {
   "id": "fleet",
   "start": 13.5,
   "dur": 8.456,
   "text": "人类倾尽两个世纪，造出两千余艘恒星级战舰。它们列成方阵，等待着眼中弱小的敌人。"
  },
  {
   "id": "drop",
   "start": 25.5,
   "dur": 2.3,
   "text": "但它们面对的，是一滴水。"
  },
  {
   "id": "ember",
   "start": 49.0,
   "dur": 2.241,
   "text": "片刻之间，方阵熄灭了。"
  },
  {
   "id": "singer",
   "start": 56.0,
   "dur": 7.302,
   "text": "在更高的地方，另一个文明只是瞥了一眼。它取出一片二向箔，像丢掉一张纸条。"
  },
  {
   "id": "quote",
   "start": 76.0,
   "dur": 2.204,
   "text": "毁灭你，与你有何相干。"
  },
  {
   "id": "fall",
   "start": 86.5,
   "dur": 9.478,
   "text": "空间开始跌落。三维，正在坍缩成二维。先是海王星，然后一个接一个，被拍进一幅无限精细的画里。"
  },
  {
   "id": "earth",
   "start": 125.5,
   "dur": 3.604,
   "text": "地球，连同它全部的历史，成了画中的一道纹路。"
  },
  {
   "id": "escape",
   "start": 144.0,
   "dur": 3.898,
   "text": "只有一艘光速飞船，逃出了这幅正在合拢的画。"
  },
  {
   "id": "back",
   "start": 149.5,
   "dur": 2.007,
   "text": "回头望去，太阳系，已经是一幅画。"
  },
  {
   "id": "pluto",
   "start": 157.5,
   "dur": 4.247,
   "text": "最后是冥王星，和刻在它石碑上的人类文明。"
  },
  {
   "id": "end",
   "start": 170.0,
   "dur": 3.537,
   "text": "给岁月以文明，而不是给文明以岁月。"
  }
 ],
